# Copy to .env and put your real key ONLY in .env (which is git- and docker-ignored).
# Use GEMINI_API_KEY only; do not also set GOOGLE_API_KEY (it would take precedence).
GEMINI_API_KEY=replace_with_your_real_key
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_STRONG_MODEL=gemini-3.8-flash
GEMINI_JUDGE_MODEL=gemini-3.8-flash
TRIAGE_PROFILE=gemini_pipeline
OLLAMA_MODEL=qwen2.5:7b-instruct
# Office LAN Ollama server (glados_only / local_reviewed profiles). Put the real address in .env only.
GLADOS_API_BASE=http://<glados-lan-ip>:11434
GLADOS_MODEL=nemotron-3.5-lightning:30b-a3b
